REVIEWLY_GITHUB_WEBHOOK_SECRET=change-me
REVIEWLY_DATABASE_URL=postgresql+psycopg://reviewly:reviewly@localhost:5432/reviewly
REVIEWLY_REDIS_URL=redis://localhost:6379/0

# GitHub App (needed for real reviews; without these the worker only logs jobs)
REVIEWLY_GITHUB_APP_ID=
REVIEWLY_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# LLM providers, tried in REVIEWLY_PROVIDER_ORDER (`provider` or `provider:model`); any without a key is skipped.
# Default: gpt-oss-120b first, qwen3.8-27b as the fallback, then Gemini/Mistral if you add keys.
# REVIEWLY_PROVIDER_ORDER=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
REVIEWLY_GEMINI_API_KEY=
REVIEWLY_GROQ_API_KEY=
REVIEWLY_MISTRAL_API_KEY=

# Repo context (RAG). Off until the eval harness shows it helps; needs prompt v2.
REVIEWLY_RAG_ENABLED=false
REVIEWLY_PROMPT_VERSION=v1
REVIEWLY_RETENTION_DAYS=30

# Dashboard. In production set both secrets to random 32+ character strings; the app refuses to start otherwise.
# REVIEWLY_ENV=prod
# REVIEWLY_GITHUB_WEBHOOK_SECRET=
# REVIEWLY_DASHBOARD_SECRET=
# REVIEWLY_PUBLIC_URL=https://your-domain
# REVIEWLY_GITHUB_OAUTH_CLIENT_ID=
# REVIEWLY_GITHUB_OAUTH_CLIENT_SECRET=
# Local development only (never in production):
# REVIEWLY_DASHBOARD_DEV_LOGIN=true   then open /auth/dev-login?installation=42

# Billing (Stripe test mode). The free tier is REVIEWLY_FREE_REVIEWS_PER_MONTH (0 = unlimited).
# REVIEWLY_STRIPE_SECRET_KEY=
# REVIEWLY_STRIPE_PRICE_ID=
# REVIEWLY_STRIPE_WEBHOOK_SECRET=

# Cost and abuse control (per installation)
REVIEWLY_DAILY_TOKEN_BUDGET=500000
REVIEWLY_LLM_RATE_PER_MIN=120
REVIEWLY_LLM_RATE_BURST=20
REVIEWLY_CACHE_ENABLED=true
REVIEWLY_CACHE_TTL_DAYS=7
REVIEWLY_REDACTION_ENABLED=true
REVIEWLY_INJECTION_FINDINGS=true
