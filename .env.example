REVIEWLY_GITHUB_WEBHOOK_SECRET=change-me
REVIEWLY_DATABASE_URL=postgresql+psycopg://reviewly:reviewly@localhost:5432/reviewly
REVIEWLY_REDIS_URL=redis://localhost:6379/0

# GitHub App (needed for real reviews; without these the worker only logs jobs)
REVIEWLY_GITHUB_APP_ID=
REVIEWLY_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# LLM providers, tried in REVIEWLY_PROVIDER_ORDER; any without a key is skipped
REVIEWLY_GEMINI_API_KEY=
REVIEWLY_GROQ_API_KEY=
REVIEWLY_MISTRAL_API_KEY=

# Repo context (RAG). Off until the eval harness shows it helps; needs prompt v2.
REVIEWLY_RAG_ENABLED=false
REVIEWLY_PROMPT_VERSION=v1
REVIEWLY_RETENTION_DAYS=30
